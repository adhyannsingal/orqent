# The Orqent backend. This is the ONLY variable the frontend needs.
#
# Every VITE_* variable is compiled into the browser bundle and is therefore
# public. Never put a credential here: no GEMINI_API_KEY, no database URL, no
# JWT signing key. The browser talks only to Orqent; Orqent talks to Gemini.
VITE_API_BASE_URL=http://localhost:8000
