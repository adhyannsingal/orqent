# Example environment configuration for Orqent.
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# Every variable maps 1:1 to a field on `app.core.config.Settings` and is read
# with the `APP_` prefix. Values shown here are safe local-development defaults;
# they contain NO real secrets. When running the full stack via
# `docker compose up`, compose injects its own in-container values (e.g. the DB
# host becomes `mysql`, not `127.0.0.1`) — this file is for running the app on
# the host with infrastructure in Docker.

# --- Core -------------------------------------------------------------------
# Deployment environment: local | test | staging | production
APP_ENVIRONMENT=local
# Enable debug behaviour (verbose errors, SQL echo). Never true in production.
APP_DEBUG=false
# Human-readable application name (used in logs / metadata).
APP_APP_NAME=multi-agent-platform

# --- API --------------------------------------------------------------------
# URL prefix under which the versioned business API is mounted.
APP_API_V1_PREFIX=/api/v1
# Allowed CORS origins, as a JSON array (pydantic-settings parses JSON for
# list fields). Empty list = no cross-origin browser access.
# Example: APP_CORS_ORIGINS=["http://localhost:3000"]
APP_CORS_ORIGINS=[]

# --- Logging ----------------------------------------------------------------
# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
# true  -> structured JSON logs (production-friendly)
# false -> human-readable console logs (nicer locally)
APP_LOG_JSON=false

# --- Authentication ---------------------------------------------------------
# Signing key for access/refresh JWTs. There is deliberately NO default: a
# shared, committed signing key would let anyone forge tokens for every
# deployment that copied this file. Uncomment the line below and generate your
# own value, otherwise the app fails fast with a clear message.
#
# Must be at least 32 bytes — this is enforced, not advisory. RFC 7518 section
# 3.2 requires an HMAC key at least as long as the hash output (32 bytes for
# SHA-256); anything shorter is brute-forceable, and a recovered key means an
# attacker can forge a token for any user. The value is never padded or
# stretched to compensate. Generate one with:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# APP_JWT_SECRET_KEY=
#
# JWT signing algorithm. HS256 is symmetric (one shared secret). Switching to
# an asymmetric algorithm (e.g. RS256) is a later configuration change.
APP_JWT_ALGORITHM=HS256
# Access-token lifetime in seconds. Short by design: access tokens are
# stateless and cannot be revoked, so the expiry is the revocation window.
APP_ACCESS_TOKEN_TTL_SECONDS=900
# Refresh-token lifetime in seconds (30 days). Long-lived, but revocable once
# the server-side rotating token store lands in Phase 3B.
APP_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Database ---------------------------------------------------------------
# Async SQLAlchemy URL (asyncmy driver). Required for the app to reach MySQL
# and for Alembic migrations. The credentials below match the local
# docker-compose MySQL service (app/app) — LOCAL DEV ONLY; never reuse these in
# staging or production.
#
#   Host-based dev (infra in Docker, app on host):
APP_DATABASE_URL=mysql+asyncmy://app:app@127.0.0.1:3306/app
#   Inside docker-compose the host is the service name instead:
#   APP_DATABASE_URL=mysql+asyncmy://app:app@mysql:3306/app

# --- Vector store (ChromaDB) — used from Phase 10 onward --------------------
# Provisioned early by docker-compose; unused until the memory phase.
APP_CHROMA_HOST=127.0.0.1
APP_CHROMA_PORT=8001
